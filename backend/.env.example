# ==============================================================================
# Bússola Astrológica - Exemplo de Variáveis de Ambiente
# ==============================================================================

# [OBRIGATÓRIO] Conexão com o banco de dados PostgreSQL
DATABASE_URL=postgresql://postgres:senha123@localhost:5432/bussolaapp_db

# [OPCIONAL] Conexão isolada usada apenas pela suíte de testes (TESTING=1) em database.py
TEST_DATABASE_URL=postgresql://postgres:senha123@localhost:5432/bussola_test

# [OBRIGATÓRIO] Credenciais do Super Admin / Administrador padrão
SUPER_ADMIN_NAME="Aryaraj"
SUPER_ADMIN_EMAIL=admin@bussola.com
SUPER_ADMIN_PASSWORD=sua_senha_segura_aqui

# [OBRIGATÓRIO] Autenticação JWT
JWT_SECRET=sua_chave_jwt_super_secreta_aqui
JWT_EXPIRE_HOURS=72

# [OBRIGATÓRIO PARA INTEGRAÇÕES EXTERNAS / WEBHOOKS]
# Chave secreta de API utilizada no header 'X-API-Key' para gerar convites e ações via API externa
EXTERNAL_API_KEY=sua_chave_secreta_super_segura_aqui

# [OBRIGATÓRIO PARA LEITURAS / MAPA] Inteligência Artificial (OpenAI)
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui
# [OPCIONAL] Modelo e esforço de raciocínio para Leituras do Dia (ai_service.py)
MODELO_LEITURA=gpt-4o-mini
RACIOCINIO_LEITURA=medium

# [OPCIONAL] Caminho para o arquivo de sessão do NotebookLM usado em notebooklm_service.py
NOTEBOOKLM_STORAGE=

# [OPCIONAL] Envio de e-mails transacionais e códigos OTP (Brevo / Sendinblue)
BREVO_API_KEY=xkeysib-sua-chave-brevo-aqui
BREVO_SENDER_NAME="Bússola Astrológica"
BREVO_SENDER_EMAIL=contato@bussolaastrologica.com.br

# [OPCIONAL] Envio de e-mails alternativo (Resend)
RESEND_API_KEY=
RESEND_FROM=

# [OPCIONAL] URL base do Frontend / Dashboard para links gerados no e-mail e convites
DASHBOARD_URL=https://bussola.seudominio.com
# [OPCIONAL] URL pública do Frontend usada nos botões de confirmação de e-mail
FRONTEND_URL=https://bussolaappfront.aryaraj.shop

# [OPCIONAL] Origens extras para o CORS separadas por vírgula
ALLOWED_ORIGINS=https://bussolaappfront.aryaraj.shop,https://bussola.seudominio.com

# [OPCIONAL] Armazenamento em Nuvem / Backups (Backblaze B2 / S3)
BACKBLAZE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=bussola-backups
BACKBLAZE_CDN_URL=
B2_FOLDER=BussolaAstrologica/backups/
B2_RETENTION_MAX=30

# [OPCIONAL] Link de checkout para o banner de upsell de Múltiplos Perfis (se vazio, o banner não é exibido)
MULTI_PROFILES_UPSELL_URL=
